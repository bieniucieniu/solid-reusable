{
  "name": "solid-reusable",
  "private": true,
  "version": "0.0.0",
  "description": "SolidJS component system — Zag headless, shadcn registry, Tailwind v4",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @solid-reusable/playground dev",
    "build": "pnpm --filter @solid-reusable/core --filter @solid-reusable/provider --filter @solid-reusable/provider-zag build",
    "build:registry": "node scripts/build-registry.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "registry:build": "pnpm build:registry"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@zag-js/solid": "^1.42.0",
    "solid-js": "^1.9.14",
    "typescript": "^5.8.3"
  }
}

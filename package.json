{
  "name": "solid-reusable",
  "private": true,
  "version": "0.0.0",
  "description": "SolidJS component system — Zag headless, shadcn registry, Tailwind v4",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "biome format --write .",
    "dev": "pnpm --filter @solid-reusable/playground dev",
    "start": "pnpm --filter @solid-reusable/playground start",
    "build": "pnpm --filter @solid-reusable/core --filter @solid-reusable/provider --filter @solid-reusable/provider-zag build",
    "build:playground": "pnpm --filter @solid-reusable/playground build",
    "build:registry": "node scripts/build-registry.mjs",
    "prepare:pages": "node scripts/prepare-pages.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "registry:build": "pnpm build:registry"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^22.15.3",
    "@zag-js/core": "^1.42.0",
    "@zag-js/solid": "^1.42.0",
    "class-variance-authority": "^0.7.1",
    "lucide-solid": "^1.28.0",
    "solid-js": "^1.9.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  }
}
